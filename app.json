{
  "expo": {
    "name": "Hanchi",
    "slug": "hanchi-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hanchi",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-hanchi.png",
      "resizeMode": "cover",
      "backgroundColor": "#7C3AED"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hanchi.app",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hanchi uses your location to center the map on you and show nearby communities and restaurants.",
        "NSPhotoLibraryUsageDescription": "Hanchi uses your photos for Moments and your profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.hanchi.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7C3AED",
          "image": "./assets/images/splash-hanchi.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Hanchi to use your location to center the map on you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hanchi to use your photos for Moments and your profile."
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
